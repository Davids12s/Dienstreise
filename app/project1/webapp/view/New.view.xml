<mvc:View controllerName="project1.controller.New"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="newPage" title="Neue Dienstreise" showNavButton="true" navButtonPress="onNavBack">
        <content>
            <VBox class="sapUiMediumMargin">

                <Label text="Zielort"/>
                <Input value="{newTrip>/zielort}"/>

                <Label text="Startdatum"/>
                <DatePicker value="{newTrip>/startdate}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"/>

                <Label text="Enddatum"/>
                <DatePicker value="{newTrip>/enddate}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"/>

                <Label text="Transportmittel"/>
                <Select selectedKey="{newTrip>/transportmittel}" change="onTransportmittelChange">
                    <core:Item key="AUTO" text="Auto"/>
                    <core:Item key="ZUG" text="Zug"/>
                    <core:Item key="FLUGZEUG" text="Flugzeug"/>
                </Select>

                <VBox visible="{= ${newTrip>/transportmittel} === 'FLUGZEUG' }">
                    <Label text="Abflugort"/>
                    <Input value="{newTrip>/abflugort}"/>

                    <Label text="Abflugdatum"/>
                    <DatePicker value="{newTrip>/abflugdatum}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"/>

                    <Label text="Ankunftsort"/>
                    <Input value="{newTrip>/ankunftsort}"/>

                    <Label text="Ankunftsdatum"/>
                    <DatePicker value="{newTrip>/ankunftsdatum}" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"/>
                </VBox>

        


                <Button text="Speichern" press="onSavePress" class="sapUiMediumMarginTop"/>

            </VBox>
        </content>
    </Page>
</mvc:View>